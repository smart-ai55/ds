package com.example.firstapp1mca; 
import android.app.AlertDialog; 
import android.os.Bundle; 
import android.os.Handler; 
import android.widget.Button; 
import android.widget.ProgressBar; 
import android.widget.TextView; 
 
import androidx.appcompat.app.AppCompatActivity; 
 
public class MainActivity extends AppCompatActivity { 
 
    ProgressBar progressBar; 
    Button button; 
    TextView txtProgress; 
    int progress = 0; 
 
    Handler handler = new Handler(); 
 
    @Override 
    protected void onCreate(Bundle savedInstanceState) { 
        super.onCreate(savedInstanceState); 
        setContentView(R.layout.activity_main); 
 
        progressBar = findViewById(R.id.progressBar); 
        button = findViewById(R.id.btnStart); 
        txtProgress = findViewById(R.id.txtProgress); 
 
        button.setOnClickListener(v -> startProgress()); 
    } 
 
    private void startProgress() { 
        progress = 0; 
        txtProgress.setText("Progress: 0%"); 
        progressBar.setProgress(0); 
 
        handler.postDelayed(new Runnable() { 
            @Override 
            public void run() { 
 
                progress += 5; 
                progressBar.setProgress(progress); 
                txtProgress.setText("Progress: " + progress + "%"); 
 
                if (progress < 100) { 
                    handler.postDelayed(this, 200); // repeat 
                } else { 
                    showAlert(); 
                } 
            } 
        }, 200); 
    } 
 
    private void showAlert() { 
        AlertDialog.Builder builder = new AlertDialog.Builder(this); 
        builder.setTitle("Completed"); 
        builder.setMessage("Progress Finished!"); 
        builder.setPositiveButton("OK", null); 
        builder.show(); 
    } 
} 




